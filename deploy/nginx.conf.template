# Rendered by the nginx image at start-up (envsubst): ${CARD_AGENT_API} = upstream card-agent API.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 520m;          # evaluation-set zips (evaluation.max_set_bytes = 500 MB)

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /console-health { default_type text/plain; return 200 "ok\n"; }

    # Live validation stream (Server-Sent Events): no buffering, long read timeout.
    location = /v1/cards/validate/stream {
        proxy_pass ${CARD_AGENT_API};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ ^/(v1|health|metrics|docs|openapi\.json) {
        proxy_pass ${CARD_AGENT_API};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;       # registry sync with re-embed, large uploads
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # `expires` (not add_header) so the server-level security headers above still apply here
    location /assets/ { expires 1y; }
    location / { try_files $uri /index.html; expires -1; }
}
